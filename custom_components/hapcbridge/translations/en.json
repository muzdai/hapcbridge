{
  "config": {
    "flow_title": "{name}",
    "step": {
      "confirm": {
        "title": "Add {name}?",
        "description": "HA PC Bridge found the PC **{name}** (`{device_id}`) on the MQTT broker."
      },
      "user": {
        "title": "Add a PC",
        "description": "Normally PCs are discovered automatically. Enter the device id from the service's config.json.",
        "data": {
          "device_id": "Device id",
          "base_topic": "Base topic"
        }
      }
    },
    "abort": {
      "already_configured": "This PC is already added",
      "invalid_discovery_info": "Unexpected MQTT topic"
    }
  },
  "entity": {
    "sensor": {
      "cpu_load": {
        "name": "CPU load"
      },
      "cpu_temp": {
        "name": "CPU temperature"
      },
      "cpu_power": {
        "name": "CPU power"
      },
      "gpu_load": {
        "name": "GPU load"
      },
      "gpu_temp": {
        "name": "GPU temperature"
      },
      "gpu_power": {
        "name": "GPU power"
      },
      "gpu_memory_used": {
        "name": "GPU memory used"
      },
      "ram_free": {
        "name": "RAM free"
      },
      "ram_usage": {
        "name": "RAM usage"
      },
      "total_power": {
        "name": "Power consumption"
      },
      "logged_user": {
        "name": "Logged user"
      },
      "last_login": {
        "name": "Last login"
      },
      "last_boot": {
        "name": "Last boot"
      },
      "active_window": {
        "name": "Active window"
      },
      "active_process": {
        "name": "Active process"
      },
      "idle_time": {
        "name": "Idle time"
      },
      "mac": {
        "name": "MAC address"
      },
      "ip": {
        "name": "IP address"
      }
    },
    "binary_sensor": {
      "locked": {
        "name": "Locked"
      }
    },
    "switch": {
      "power": {
        "name": "Computer"
      }
    },
    "button": {
      "shutdown": {
        "name": "Shutdown"
      },
      "restart": {
        "name": "Restart"
      },
      "abort_shutdown": {
        "name": "Abort shutdown"
      },
      "sleep": {
        "name": "Sleep"
      },
      "hibernate": {
        "name": "Hibernate"
      },
      "lock": {
        "name": "Lock"
      },
      "logoff": {
        "name": "Log off"
      },
      "monitor_off": {
        "name": "Monitor off"
      },
      "close_active_window": {
        "name": "Close active window"
      }
    },
    "notify": {
      "notification": {
        "name": "Notification"
      }
    }
  },
  "services": {
    "set_config": {
      "name": "Change PC settings",
      "description": "Sends a partial settings object to the PC (same keys as config.json, broker settings excluded).",
      "fields": {
        "config_entry_id": {
          "name": "PC",
          "description": "Config entry of the PC"
        },
        "config": {
          "name": "Settings",
          "description": "For example {\"temperatureUnit\": \"F\", \"sensors\": {\"idleTime\": false}}"
        }
      }
    },
    "command": {
      "name": "PC command",
      "description": "Sends a command to the Computer object.",
      "fields": {
        "command": {
          "name": "Command",
          "description": ""
        }
      }
    },
    "notify": {
      "name": "PC notification",
      "description": "Shows a Windows notification on the PC. Clicks and buttons come back as the hapcbridge_notification event.",
      "fields": {
        "message": {
          "name": "Message",
          "description": ""
        },
        "title": {
          "name": "Title",
          "description": ""
        },
        "actions": {
          "name": "Buttons",
          "description": "Up to five buttons: a list of {id, title} or plain titles."
        },
        "tag": {
          "name": "Tag",
          "description": "Returned in the event; a new notification with the same tag replaces the old one."
        },
        "duration": {
          "name": "Duration",
          "description": "short is about 7 s, long about 25 s."
        },
        "silent": {
          "name": "Silent",
          "description": ""
        }
      }
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Entities",
        "description": "The Computer object (switch.<id>_computer) is always created: on/off state, every sensor as an attribute, commands through the hapcbridge.command action. Optionally also create one entity per sensor and command.",
        "data": {
          "separate_entities": "Separate sensor and button entities"
        }
      }
    }
  },
  "selector": {
    "command": {
      "options": {
        "shutdown": "Shutdown",
        "restart": "Restart",
        "abort_shutdown": "Abort shutdown",
        "sleep": "Sleep",
        "hibernate": "Hibernate",
        "lock": "Lock",
        "logoff": "Log off",
        "monitor_off": "Monitor off",
        "close_active_window": "Close active window"
      }
    }
  }
}